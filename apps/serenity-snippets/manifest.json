{
  "manifest_version": 3,
  "name": "Serenity Snippets",
  "version": "1.0.0",
  "description": "Pre-written caregiver note snippets. Click to copy, search as you type, favorites, and keyboard shortcuts that type a snippet into any text box.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Serenity Snippets (Alt+Shift+S)",
    "default_popup": "index.html?popup=1"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Serenity Snippets"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["snippets.js", "shared.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
